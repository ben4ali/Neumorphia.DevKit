    "src/registry/components",
    "README.md"
  ],
  "keywords": [
    "neumorphism",
    "neumorphic",
    "soft-ui",
    "react",
    "tailwindcss",
    "ui-kit",
    "components",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ben4ali/Neumorphia.DevKit.git"
  },
  "scripts": {
    "dev": "vite",
    "generate-sitemap": "node scripts/generate-sitemap.js",
    "build": "node scripts/generate-sitemap.js && tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.475.0",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.29.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
